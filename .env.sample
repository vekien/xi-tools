# ------------------------------------
# Paths
# ------------------------------------
#
# Every path below is an EXAMPLE, not a default — leave it commented out unless you are
# filling in your own value. An uncommented example gets copied into .env on install and
# is then read back as though you had configured it, which hides the fact that nothing is
# actually set. The zone editor's Setup panel writes these for you.

# Your main FFXI Directory
#FFXI_DIR=C:\Program Files (x86)\PlayOnline\SquareEnix\FINAL FANTASY XI

# HD asset-pack DATs (Publish-to-HD target / HD preview).
#FFXI_HD_DIR=C:\path\to\Ashita\polplugins\DATs\ffxi-hd

# Path for pivot files, used in --pivot args
#FFXI_PIVOT_DIR=C:\path\to\Ashita\polplugins\DATs\your-overlay

# Root of this tools checkout (texconv etc. resolve relative to it).
# The desktop app sets this automatically; CLI users should point it at their checkout.
#XI_TOOLS_DIR=C:\path\to\xi-tools

# ------------------------------------
# Misc
# ------------------------------------

# Max injected zone-texture dimension
XI_TEXTURE_CLAMP=2048

# Auto-apply zone migrations on `zone new` when the DB is reachable. 0/false/no/off disables.
#XI_DB_AUTOAPPLY=

# ── Custom model_id ceilings (advanced — defaults are sane) ──────────────────
#XI_MAX_ENTITY_MODELID=30000
#XI_MAX_GEAR_MODELID=4095
#XI_GEAR_RECOMMENDED_START=3000

# Write the <stem>_schema.json dats descriptor on `xi mesh export` (on by
# default; set false to skip). The --schema/--no-schema flag overrides per run.
#SCHEMA_GENERATION=false

# ------------------------------------
# Tools
# ------------------------------------

# Only needed for FBX conversion (`xi entity mesh/anim export --fbx`) and icon
# rendering. The zone editor itself never calls Blender.
#BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe

# texconv.exe — defaults to <XI_TOOLS_DIR>\misc\texconv.exe; uncomment to override.
#TEXCONV_PATH=

# Custom ROM namespace used for all injected content.
CUSTOM_FTABLE=ROM10

# ------------------------------------
# Server + Navmesh
# ------------------------------------

# Your LandSandBoat server source checkout: where an ability build's Lua Stub is written
# (scripts/actions) and what `xi server ws-widen` / `xi server check` read. The model
# viewer's Settings › Local Server edits this line and the database lines below.
#XI_SERVER_DIR=C:\path\to\your\server-checkout

# Pre-baked <ZoneName>.nav files. Defaults to a sibling xi-server/xiNavmeshes if present.
#XI_NAVMESH_DIR=C:\path\to\xi-server\xiNavmeshes

# ------------------------------------
# Local Database
# ------------------------------------
#
# The database login every xi command uses (xi server db/check, zone new's auto-apply,
# dats build --apply-db). This file is the only place it comes from: the server's
# settings/network.lua is not read. A key left out uses the value shown. The database
# counts as configured once XI_DB_HOST, XI_DB_USER or XI_DB_NAME is set.
#XI_DB_HOST=127.0.0.1
#XI_DB_PORT=3306
#XI_DB_USER=root
#XI_DB_PASSWORD=
#XI_DB_NAME=xidb
