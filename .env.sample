# ------------------------------------
# Paths
# ------------------------------------

# Your main FFXI Directory
FFXI_DIR=C:\Program Files (x86)\PlayOnline\SquareEnix\FINAL FANTASY XI

# HD asset-pack DATs (Publish-to-HD target / HD preview).
FFXI_HD_DIR=C:\Path\To\Ashita\polplugins\DATs\ffxi-hd

# Path for pivot files, used in --pivot args
FFXI_PIVOT_DIR=C:\Path\To\Ashita\polplugins\DATs\<your-overlay>

# Root of this tools checkout (texconv etc. resolve relative to it).
XI_TOOLS_DIR=D:\xi-tools

# ------------------------------------
# Misc
# ------------------------------------

# Max injected zone-texture dimension
XI_TEXTURE_CLAMP=2048

# Auto-apply zone migrations on `zone new` when the DB is reachable. 0/false/no/off disables.
#XI_DB_AUTOAPPLY=

# ── Custom model_id ceilings (advanced — defaults are sane) ──────────────────
#XI_MAX_ENTITY_MODELID=30000
#XI_MAX_GEAR_MODELID=4095
#XI_GEAR_RECOMMENDED_START=3000

# Write the <stem>_schema.json dats descriptor on `xi mesh export` (on by
# default; set false to skip). The --schema/--no-schema flag overrides per run.
#SCHEMA_GENERATION=false

# ------------------------------------
# Tools
# ------------------------------------

BLENDER_PATH=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe

# texconv.exe — defaults to <XI_TOOLS_DIR>\misc\texconv.exe; uncomment to override.
#TEXCONV_PATH=

# Custom ROM namespace used for all injected content.
CUSTOM_FTABLE=ROM10

# ------------------------------------
# Server + Navmesh
# ------------------------------------

XI_SERVER_DIR=D:\path\to\your\server-checkout
XI_NAVMESH_DIR=D:\xi-server\xiNavmeshes

# ------------------------------------
# Local Database
# ------------------------------------
XI_DB_HOST=127.0.0.1
XI_DB_PORT=3306
XI_DB_USER=root
XI_DB_PASSWORD=xi
XI_DB_NAME=tpzdb
