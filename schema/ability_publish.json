{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi.tools/schema/ability_publish.json",
  "title": "xi ability publish folder record",
  "description": "placements.json in the folder an ability publish writes: projects/abilities/<slug>/, where <slug> is the action id's last part (ability.love -> love). Beside it sit the server SQL and a copy of every DAT the publish placed, at its ROM path, so the folder drops into a DAT overlay as it is; this record says what file id each copy registers as. `dats build` (and `xi ability publish`, the same thing) rewrites the folder on every publish of the action, removing what the previous publish put there and nothing else. The model viewer's Publish also writes the mix file it prepared, <Name>.mix.json (its Check writes check.<Name>.mix.json), and --apply-db writes <slug>_<animation>.applied.sql, what ran against the database; neither is listed here, and a republish never removes a mix file. See docs/ability/mixer.md#the-publish-folder.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "kind", "animation", "placements", "server"],
  "properties": {
    "schema": {"type": "string", "const": "xi.ability-publish.v1"},
    "id": {"$ref": "common.json#/$defs/actionId", "description": "The dats action that published it (ability.<slug>)."},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "The recipe's name (ability_recipe.json)."},
    "kind": {
      "type": "string",
      "enum": ["ja", "spell", "ws"],
      "description": "What the client looks the DATs up as: a job ability (file_id 4412 + animation), a spell (0xAF0 + animation) or a weapon skill (per-race extended bank slots: body, and two waist companions at +8 and +16)."
    },
    "animation": {"type": "integer", "minimum": 0, "maximum": 4095, "description": "The animation number the server row carries."},
    "placements": {
      "type": "array",
      "minItems": 1,
      "description": "One entry per DAT copy in the folder, as recorded on the action's result.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["race", "role", "file_id", "dat"],
        "properties": {
          "race": {"type": ["string", "null"], "description": "The race of a weapon skill's DAT; null for a job ability or spell (one DAT for every race)."},
          "role": {"type": "string", "enum": ["body", "companion_a", "companion_b"]},
          "file_id": {"type": "integer", "minimum": 0, "description": "The file id to register the DAT as."},
          "dat": {"$ref": "common.json#/$defs/romPath", "description": "Where the DAT was placed in the target, and where its copy sits in this folder."}
        }
      }
    },
    "server": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_.-]+\\.sql$",
      "description": "The server SQL file in this folder (<slug>_<animation>.sql); null when the action's server.emit is false."
    }
  },
  "examples": [
    {
      "schema": "xi.ability-publish.v1",
      "id": "ability.love",
      "name": "LOVE",
      "kind": "ws",
      "animation": 300,
      "placements": [
        {"race": "HumeMale", "role": "body", "file_id": 432016, "dat": "ROM10/28/2.DAT"},
        {"race": "HumeMale", "role": "companion_a", "file_id": 432024, "dat": "ROM10/28/0.DAT"},
        {"race": "HumeMale", "role": "companion_b", "file_id": 432032, "dat": "ROM10/28/1.DAT"},
        {"race": "HumeFemale", "role": "body", "file_id": 432017, "dat": "ROM10/28/3.DAT"},
        {"race": "HumeFemale", "role": "companion_a", "file_id": 432025, "dat": "ROM10/28/10.DAT"},
        {"race": "HumeFemale", "role": "companion_b", "file_id": 432033, "dat": "ROM10/28/11.DAT"},
        {"race": "ElvaanMale", "role": "body", "file_id": 432018, "dat": "ROM10/28/4.DAT"},
        {"race": "ElvaanMale", "role": "companion_a", "file_id": 432026, "dat": "ROM10/28/12.DAT"},
        {"race": "ElvaanMale", "role": "companion_b", "file_id": 432034, "dat": "ROM10/28/13.DAT"},
        {"race": "ElvaanFemale", "role": "body", "file_id": 432019, "dat": "ROM10/28/5.DAT"},
        {"race": "ElvaanFemale", "role": "companion_a", "file_id": 432027, "dat": "ROM10/28/14.DAT"},
        {"race": "ElvaanFemale", "role": "companion_b", "file_id": 432035, "dat": "ROM10/28/15.DAT"},
        {"race": "TaruMale", "role": "body", "file_id": 432020, "dat": "ROM10/28/6.DAT"},
        {"race": "TaruMale", "role": "companion_a", "file_id": 432028, "dat": "ROM10/28/16.DAT"},
        {"race": "TaruMale", "role": "companion_b", "file_id": 432036, "dat": "ROM10/28/17.DAT"},
        {"race": "TaruFemale", "role": "body", "file_id": 432021, "dat": "ROM10/28/7.DAT"},
        {"race": "TaruFemale", "role": "companion_a", "file_id": 432029, "dat": "ROM10/28/18.DAT"},
        {"race": "TaruFemale", "role": "companion_b", "file_id": 432037, "dat": "ROM10/28/19.DAT"},
        {"race": "Mithra", "role": "body", "file_id": 432022, "dat": "ROM10/28/8.DAT"},
        {"race": "Mithra", "role": "companion_a", "file_id": 432030, "dat": "ROM10/28/20.DAT"},
        {"race": "Mithra", "role": "companion_b", "file_id": 432038, "dat": "ROM10/28/21.DAT"},
        {"race": "Galka", "role": "body", "file_id": 432023, "dat": "ROM10/28/9.DAT"},
        {"race": "Galka", "role": "companion_a", "file_id": 432031, "dat": "ROM10/28/22.DAT"},
        {"race": "Galka", "role": "companion_b", "file_id": 432039, "dat": "ROM10/28/23.DAT"}
      ],
      "server": "love_300.sql"
    },
    {
      "schema": "xi.ability-publish.v1",
      "id": "ability.tiger_fury",
      "name": "tiger_fury",
      "kind": "ja",
      "animation": 339,
      "placements": [
        {"race": null, "role": "body", "file_id": 4751, "dat": "ROM10/20/0.DAT"}
      ],
      "server": "tiger_fury_339.sql"
    }
  ]
}
