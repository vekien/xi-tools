{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi.tools/schema/common.json",
  "title": "xi dats shared schema pieces",
  "type": "object",
  "$defs": {
    "actionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "description": "Stable package-local action id. This is also the key used in projects/locks.json."
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to projects/resources unless otherwise noted. Use forward slashes."
    },
    "romPath": {
      "type": "string",
      "pattern": "^ROM[0-9]*/[0-9]+/[0-9]+(?:\\.DAT)?$",
      "description": "ROM-relative DAT path such as ROM/33/17.DAT or ROM10/2/0.DAT."
    },
    "autoOrInteger": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "const": "auto"}
      ]
    },
    "outputTree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "hd": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "server": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        }
      }
    },
    "baseAction": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/actionId"},
        "type": {"type": "string"},
        "enabled": {"type": "boolean", "default": true},
        "description": {"type": "string"},
        "depends_on": {
          "type": "array",
          "items": {"$ref": "#/$defs/actionId"},
          "uniqueItems": true
        },
        "outputs": {"$ref": "#/$defs/outputTree"}
      }
    }
  }
}
